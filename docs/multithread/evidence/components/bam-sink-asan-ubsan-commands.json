{
  "compile": [
    "<APPLE_COMMAND_LINE_TOOLS>/usr/bin/c++",
    "-std=c++11",
    "-O1",
    "-g",
    "-fno-omit-frame-pointer",
    "-fsanitize=address,undefined",
    "-DGTEST_LINKED_AS_SHARED_LIBRARY=1",
    "-I<WORKSPACE>/work/NuExpansionHunter/ehunter",
    "-isystem",
    "<WORKSPACE>/work/toolchain/env/include",
    "<WORKSPACE>/work/NuExpansionHunter/ehunter/io/BamRecordSink.cpp",
    "<WORKSPACE>/work/bam-sink-validation/seeking-error-fix/sink-only-tests.cpp",
    "-L<WORKSPACE>/work/toolchain/env/lib",
    "-lhts",
    "-lgtest_main",
    "-lgtest",
    "-Wl,-rpath,<WORKSPACE>/work/toolchain/env/lib",
    "-o",
    "<WORKSPACE>/work/bam-sink-validation/seeking-error-fix/sink_asan"
  ],
  "run": [
    "<WORKSPACE>/work/bam-sink-validation/seeking-error-fix/sink_asan",
    "--gtest_filter=BamRecordSink.*",
    "--gtest_repeat=20",
    "--gtest_break_on_failure",
    "--gtest_output=xml:<WORKSPACE>/work/bam-sink-validation/seeking-error-fix/asan.xml"
  ],
  "runtime_environment": {
    "DYLD_LIBRARY_PATH": "/usr/lib:<WORKSPACE>/work/toolchain/env/lib",
    "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1",
    "TSAN_OPTIONS": "halt_on_error=1"
  },
  "_publication": {
    "source_file": "<WORKSPACE>/work/bam-sink-validation/seeking-error-fix/asan.commands.json",
