--- a/bgzf.c
+++ b/bgzf.c
@@ -475,6 +475,47 @@
 }
 
 #ifdef HAVE_LIBDEFLATE
+// libdeflate workspaces can be reused across independent BGZF blocks. Each
+// active HTS worker owns its codec, and thread exit releases both workspaces.
+struct bgzf_codecs {
+    struct libdeflate_compressor *encoder;
+    struct libdeflate_decompressor *decoder;
+    int level;
+};
+
+static pthread_once_t bgzf_codec_once = PTHREAD_ONCE_INIT;
+static pthread_key_t bgzf_codec_key;
+static int bgzf_codec_key_error;
+
+static void bgzf_destroy_codecs(void *p)
+{
+    struct bgzf_codecs *c = p;
+    libdeflate_free_compressor(c->encoder);
+    libdeflate_free_decompressor(c->decoder);
+    free(c);
+}
+
+static void bgzf_make_codec_key(void)
+{
+    bgzf_codec_key_error = pthread_key_create(&bgzf_codec_key, bgzf_destroy_codecs);
+}
+
+static struct bgzf_codecs *bgzf_thread_codecs(void)
+{
+    if (pthread_once(&bgzf_codec_once, bgzf_make_codec_key) || bgzf_codec_key_error)
+        return NULL;
+    struct bgzf_codecs *c = pthread_getspecific(bgzf_codec_key);
+    if (!c) {
+        c = calloc(1, sizeof(*c));
+        if (!c) return NULL;
+        if (pthread_setspecific(bgzf_codec_key, c)) {
+            free(c);
+            return NULL;
+        }
+    }
+    return c;
+}
